{
  "info": {
    "name": "Odyssey API — Member B (Reservations & Waitlist)",
    "description": "Newman-runnable demo for Member B scope (requirements 3-6, 8-9, 12-13). Targets the INTEGRATED app (Member A's auth/restaurants merged in). Prerequisites: (1) API running against Atlas with transactions; (2) run `npm run db:setup`; (3) an admin account exists — register {{adminEmail}} then `npm run admin:grant -- {{adminEmail}}`. Run the whole collection top-to-bottom; folders depend on earlier ones. Run: `newman run postman/member-b.postman_collection.json`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "userEmail", "value": "member-b-user@example.com" },
    { "key": "userPassword", "value": "Password123!" },
    { "key": "otherEmail", "value": "member-b-other@example.com" },
    { "key": "otherPassword", "value": "Password123!" },
    { "key": "adminEmail", "value": "ada@example.com" },
    { "key": "adminPassword", "value": "change-this-password" },
    { "key": "userToken", "value": "" },
    { "key": "otherToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "restaurantId", "value": "" },
    { "key": "fullRestaurantId", "value": "" },
    { "key": "reservationId", "value": "" },
    { "key": "fullBookingId", "value": "" },
    { "key": "waitlistId", "value": "" },
    { "key": "reservationDate", "value": "2026-12-01" },
    { "key": "reservationTime", "value": "18:00" },
    { "key": "waitDate", "value": "2026-12-02" },
    { "key": "waitTime", "value": "19:00" }
  ],
  "item": [
    {
      "name": "0. Setup (auth + seed restaurant)",
      "item": [
        {
          "name": "Register user",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/register",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Member B User\",\n  \"telephone\": \"0810000001\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Registered or already exists', () => pm.expect([201, 409]).to.include(pm.response.code));"] } }]
        },
        {
          "name": "Login user",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('User logged in', () => pm.response.to.have.status(200));", "if (pm.response.code === 200) pm.collectionVariables.set('userToken', pm.response.json().token);"] } }]
        },
        {
          "name": "Register other user",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/register",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Member B Other\",\n  \"telephone\": \"0810000002\",\n  \"email\": \"{{otherEmail}}\",\n  \"password\": \"{{otherPassword}}\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Registered or already exists', () => pm.expect([201, 409]).to.include(pm.response.code));"] } }]
        },
        {
          "name": "Login other user",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{otherEmail}}\",\n  \"password\": \"{{otherPassword}}\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Other user logged in', () => pm.response.to.have.status(200));", "if (pm.response.code === 200) pm.collectionVariables.set('otherToken', pm.response.json().token);"] } }]
        },
        {
          "name": "Login admin (grant first)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Admin logged in', () => pm.response.to.have.status(200));", "if (pm.response.code === 200) {", "  const body = pm.response.json();", "  pm.collectionVariables.set('adminToken', body.token);", "  pm.test('Account has admin role (run admin:grant first)', () => pm.expect(body.user.role).to.equal('admin'));", "}"] } }]
        },
        {
          "name": "Create restaurant (admin seed)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/restaurants",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Odyssey Bistro\",\n  \"address\": \"Bangkok\",\n  \"telephone\": \"021234567\",\n  \"opensAt\": \"10:00\",\n  \"closesAt\": \"22:00\",\n  \"totalTables\": 20\n}" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Restaurant created', () => pm.response.to.have.status(201));", "if (pm.response.code === 201) pm.collectionVariables.set('restaurantId', pm.response.json().restaurant.id);"] } }]
        }
      ]
    },
    {
      "name": "1. Create Booking (demo 4)",
      "item": [
        {
          "name": "Create reservation",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": "{{baseUrl}}/api/reservations",
            "body": { "mode": "raw", "raw": "{\n  \"restaurantId\": \"{{restaurantId}}\",\n  \"reservationDate\": \"{{reservationDate}}\",\n  \"reservationTime\": \"{{reservationTime}}\",\n  \"partySize\": 4,\n  \"tablesRequested\": 2\n}" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Created', () => pm.response.to.have.status(201));", "if (pm.response.code === 201) {", "  const r = pm.response.json();", "  pm.collectionVariables.set('reservationId', r.id);", "  pm.test('Status confirmed', () => pm.expect(r.status).to.equal('confirmed'));", "  pm.test('Up to 3 tables', () => pm.expect(r.tablesRequested).to.be.within(1, 3));", "}"] } }]
        },
        {
          "name": "Invalid: more than 3 tables (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": "{{baseUrl}}/api/reservations",
            "body": { "mode": "raw", "raw": "{\n  \"restaurantId\": \"{{restaurantId}}\",\n  \"reservationDate\": \"{{reservationDate}}\",\n  \"reservationTime\": \"{{reservationTime}}\",\n  \"partySize\": 10,\n  \"tablesRequested\": 4\n}" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Rejected with 400', () => pm.response.to.have.status(400));"] } }]
        },
        {
          "name": "Invalid: date in the past (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": "{{baseUrl}}/api/reservations",
            "body": { "mode": "raw", "raw": "{\n  \"restaurantId\": \"{{restaurantId}}\",\n  \"reservationDate\": \"2020-01-01\",\n  \"reservationTime\": \"{{reservationTime}}\",\n  \"partySize\": 2,\n  \"tablesRequested\": 1\n}" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Rejected with 400', () => pm.response.to.have.status(400));", "pm.test('Code SLOT_IN_PAST', () => pm.expect(pm.response.json().error.code).to.equal('SLOT_IN_PAST'));"] } }]
        },
        {
          "name": "Invalid: missing fields (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": "{{baseUrl}}/api/reservations",
            "body": { "mode": "raw", "raw": "{\n  \"restaurantId\": \"{{restaurantId}}\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Rejected with 400', () => pm.response.to.have.status(400));"] } }]
        },
        {
          "name": "Invalid: unknown restaurant (404)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": "{{baseUrl}}/api/reservations",
            "body": { "mode": "raw", "raw": "{\n  \"restaurantId\": \"652000000000000000000099\",\n  \"reservationDate\": \"{{reservationDate}}\",\n  \"reservationTime\": \"{{reservationTime}}\",\n  \"partySize\": 2,\n  \"tablesRequested\": 1\n}" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Rejected with 404', () => pm.response.to.have.status(404));"] } }]
        }
      ]
    },
    {
      "name": "2. View Own Booking (demo 5)",
      "item": [
        {
          "name": "List own reservations",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": "{{baseUrl}}/api/reservations"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Listed', () => pm.response.to.have.status(200));", "pm.test('Contains created reservation', () => pm.expect(pm.response.json().items.map((i) => i.id)).to.include(pm.collectionVariables.get('reservationId')));"] } }]
        },
        {
          "name": "Get reservation by id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": "{{baseUrl}}/api/reservations/{{reservationId}}"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Found', () => pm.response.to.have.status(200));", "pm.test('Correct id', () => pm.expect(pm.response.json().id).to.equal(pm.collectionVariables.get('reservationId')));"] } }]
        },
        {
          "name": "No auth is rejected (401)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/reservations" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Unauthorized', () => pm.response.to.have.status(401));"] } }]
        }
      ]
    },
    {
      "name": "3. Edit Own Booking (demo 6)",
      "item": [
        {
          "name": "Edit reservation",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": "{{baseUrl}}/api/reservations/{{reservationId}}",
            "body": { "mode": "raw", "raw": "{\n  \"partySize\": 6,\n  \"reservationTime\": \"19:30\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Updated', () => pm.response.to.have.status(200));", "pm.test('Party size changed', () => pm.expect(pm.response.json().partySize).to.equal(6));"] } }]
        }
      ]
    },
    {
      "name": "4. Ownership guard",
      "item": [
        {
          "name": "Other user cannot view (403)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{otherToken}}" }],
            "url": "{{baseUrl}}/api/reservations/{{reservationId}}"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Forbidden', () => pm.response.to.have.status(403));"] } }]
        },
        {
          "name": "Other user cannot edit (403)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{otherToken}}" }],
            "url": "{{baseUrl}}/api/reservations/{{reservationId}}",
            "body": { "mode": "raw", "raw": "{\n  \"partySize\": 1\n}" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Forbidden', () => pm.response.to.have.status(403));"] } }]
        }
      ]
    },
    {
      "name": "5. Admin on any booking (demo 10-12)",
      "item": [
        {
          "name": "Admin views any reservation",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/reservations/{{reservationId}}"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Admin can view', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Admin edits any reservation",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/reservations/{{reservationId}}",
            "body": { "mode": "raw", "raw": "{\n  \"partySize\": 5\n}" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Admin can edit', () => pm.response.to.have.status(200));"] } }]
        }
      ]
    },
    {
      "name": "6. Delete Booking + history (demo 7, req 13)",
      "item": [
        {
          "name": "Cancel reservation",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": "{{baseUrl}}/api/reservations/{{reservationId}}"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Cancelled (204)', () => pm.response.to.have.status(204));"] } }]
        },
        {
          "name": "Cancelled booking retained in history",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": "{{baseUrl}}/api/reservations/{{reservationId}}"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Still viewable', () => pm.response.to.have.status(200));", "pm.test('Status is cancelled', () => pm.expect(pm.response.json().status).to.equal('cancelled'));"] } }]
        },
        {
          "name": "History filter: cancelled",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": "{{baseUrl}}/api/reservations?status=cancelled"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Listed', () => pm.response.to.have.status(200));", "pm.test('Only cancelled returned', () => pm.response.json().items.forEach((i) => pm.expect(i.status).to.equal('cancelled')));"] } }]
        },
        {
          "name": "History filter: upcoming",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": "{{baseUrl}}/api/reservations?when=upcoming"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Listed', () => pm.response.to.have.status(200));", "pm.test('Only confirmed returned', () => pm.response.json().items.forEach((i) => pm.expect(i.status).to.equal('confirmed')));"] } }]
        }
      ]
    },
    {
      "name": "7. Waitlist (extra credit, req 12)",
      "item": [
        {
          "name": "Create full restaurant (1 table)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/restaurants",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Odyssey Counter\",\n  \"address\": \"Bangkok\",\n  \"telephone\": \"021234568\",\n  \"opensAt\": \"10:00\",\n  \"closesAt\": \"22:00\",\n  \"totalTables\": 1\n}" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Created', () => pm.response.to.have.status(201));", "if (pm.response.code === 201) pm.collectionVariables.set('fullRestaurantId', pm.response.json().restaurant.id);"] } }]
        },
        {
          "name": "User fills the only table",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": "{{baseUrl}}/api/reservations",
            "body": { "mode": "raw", "raw": "{\n  \"restaurantId\": \"{{fullRestaurantId}}\",\n  \"reservationDate\": \"{{waitDate}}\",\n  \"reservationTime\": \"{{waitTime}}\",\n  \"partySize\": 2,\n  \"tablesRequested\": 1\n}" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Booked', () => pm.response.to.have.status(201));", "if (pm.response.code === 201) pm.collectionVariables.set('fullBookingId', pm.response.json().id);"] } }]
        },
        {
          "name": "Other user: slot full on booking (409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{otherToken}}" }],
            "url": "{{baseUrl}}/api/reservations",
            "body": { "mode": "raw", "raw": "{\n  \"restaurantId\": \"{{fullRestaurantId}}\",\n  \"reservationDate\": \"{{waitDate}}\",\n  \"reservationTime\": \"{{waitTime}}\",\n  \"partySize\": 2,\n  \"tablesRequested\": 1\n}" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Slot full', () => pm.response.to.have.status(409));", "pm.test('Code SLOT_FULL', () => pm.expect(pm.response.json().error.code).to.equal('SLOT_FULL'));"] } }]
        },
        {
          "name": "Other user joins waitlist",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{otherToken}}" }],
            "url": "{{baseUrl}}/api/waitlist",
            "body": { "mode": "raw", "raw": "{\n  \"restaurantId\": \"{{fullRestaurantId}}\",\n  \"reservationDate\": \"{{waitDate}}\",\n  \"reservationTime\": \"{{waitTime}}\",\n  \"partySize\": 2,\n  \"tablesRequested\": 1\n}" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Joined (201)', () => pm.response.to.have.status(201));", "if (pm.response.code === 201) {", "  const e = pm.response.json();", "  pm.collectionVariables.set('waitlistId', e.id);", "  pm.test('Status waiting', () => pm.expect(e.status).to.equal('waiting'));", "}"] } }]
        },
        {
          "name": "Duplicate join rejected (409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{otherToken}}" }],
            "url": "{{baseUrl}}/api/waitlist",
            "body": { "mode": "raw", "raw": "{\n  \"restaurantId\": \"{{fullRestaurantId}}\",\n  \"reservationDate\": \"{{waitDate}}\",\n  \"reservationTime\": \"{{waitTime}}\",\n  \"partySize\": 2,\n  \"tablesRequested\": 1\n}" }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Already waiting', () => pm.response.to.have.status(409));"] } }]
        },
        {
          "name": "User cancels booking (frees + promotes)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": "{{baseUrl}}/api/reservations/{{fullBookingId}}"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Cancelled (204)', () => pm.response.to.have.status(204));"] } }]
        },
        {
          "name": "Other user sees offer",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{otherToken}}" }],
            "url": "{{baseUrl}}/api/waitlist"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Listed', () => pm.response.to.have.status(200));", "const entry = pm.response.json().items.find((i) => i.id === pm.collectionVariables.get('waitlistId'));", "pm.test('Entry was offered', () => pm.expect(entry.status).to.equal('offered'));", "pm.test('Offer has expiry', () => pm.expect(entry.offerExpiresAt).to.not.equal(null));"] } }]
        },
        {
          "name": "Other user accepts offer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{otherToken}}" }],
            "url": "{{baseUrl}}/api/waitlist/{{waitlistId}}/accept"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Accepted -> reservation (201)', () => pm.response.to.have.status(201));", "pm.test('Reservation confirmed', () => pm.expect(pm.response.json().status).to.equal('confirmed'));"] } }]
        }
      ]
    }
  ]
}
