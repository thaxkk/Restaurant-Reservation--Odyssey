{
  "info": {
    "name": "Odyssey API — Extra Credits only (req 10,11,12,13)",
    "description": "Focused runner for the EXTRA CREDITS demo only: admin restaurant management (10), admin reservation query with pagination/filter/sort (11), FIFO waitlist (12), and reservation history (13). Self-seeding; run top-to-bottom. Needs a promoted admin (adminEmail/adminPassword) and the API on baseUrl. To show a 'completed' booking, pre-seed one per the runbook.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "adminEmail", "value": "admin@example.com" },
    { "key": "adminPassword", "value": "Admin123!" },
    { "key": "userAEmail", "value": "usera@example.com" },
    { "key": "userBEmail", "value": "userb@example.com" },
    { "key": "userCEmail", "value": "userc@example.com" },
    { "key": "userPassword", "value": "User1234!" },
    { "key": "adminToken", "value": "" },
    { "key": "aToken", "value": "" },
    { "key": "bToken", "value": "" },
    { "key": "cToken", "value": "" },
    { "key": "mainRestaurantId", "value": "" },
    { "key": "delId", "value": "" },
    { "key": "counterId", "value": "" },
    { "key": "aBookingId", "value": "" },
    { "key": "bEntryId", "value": "" }
  ],
  "item": [
    {
      "name": "00 Setup (login admin + users)",
      "item": [
        {
          "name": "Health ready",
          "request": { "method": "GET", "url": "{{baseUrl}}/health/ready" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('API ready', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Login admin",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/api/auth/login", "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}" } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Admin logged in', () => pm.response.to.have.status(200));", "const b = pm.response.json();", "if (pm.response.code === 200) { pm.collectionVariables.set('adminToken', b.token); pm.test('Has admin role', () => pm.expect(b.user.role).to.equal('admin')); }"] } }]
        },
        {
          "name": "Register users (tolerant)",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/api/auth/register", "body": { "mode": "raw", "raw": "{\n  \"name\": \"User A\",\n  \"telephone\": \"0810000001\",\n  \"email\": \"{{userAEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}" } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Registered or exists', () => pm.expect([201,409]).to.include(pm.response.code));"] } }]
        },
        {
          "name": "Register user B (tolerant)",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/api/auth/register", "body": { "mode": "raw", "raw": "{\n  \"name\": \"User B\",\n  \"telephone\": \"0810000002\",\n  \"email\": \"{{userBEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}" } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Registered or exists', () => pm.expect([201,409]).to.include(pm.response.code));"] } }]
        },
        {
          "name": "Register user C (tolerant)",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/api/auth/register", "body": { "mode": "raw", "raw": "{\n  \"name\": \"User C\",\n  \"telephone\": \"0810000003\",\n  \"email\": \"{{userCEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}" } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Registered or exists', () => pm.expect([201,409]).to.include(pm.response.code));"] } }]
        },
        {
          "name": "Login user A",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/api/auth/login", "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{userAEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}" } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('A logged in', () => pm.response.to.have.status(200));", "if (pm.response.code === 200) pm.collectionVariables.set('aToken', pm.response.json().token);"] } }]
        },
        {
          "name": "Login user B",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/api/auth/login", "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{userBEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}" } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('B logged in', () => pm.response.to.have.status(200));", "if (pm.response.code === 200) pm.collectionVariables.set('bToken', pm.response.json().token);"] } }]
        },
        {
          "name": "Login user C",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/api/auth/login", "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{userCEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}" } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('C logged in', () => pm.response.to.have.status(200));", "if (pm.response.code === 200) pm.collectionVariables.set('cToken', pm.response.json().token);"] } }]
        }
      ]
    },
    {
      "name": "REQ 10 — Admin restaurant management",
      "item": [
        {
          "name": "Admin creates restaurant (capacity 20)",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/restaurants", "body": { "mode": "raw", "raw": "{\n  \"name\": \"EC Main {{$timestamp}}\",\n  \"address\": \"Bangkok\",\n  \"telephone\": \"021234567\",\n  \"opensAt\": \"10:00\",\n  \"closesAt\": \"22:00\",\n  \"totalTables\": 20\n}" } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Created 201', () => pm.response.to.have.status(201));", "if (pm.response.code === 201) { const r = pm.response.json(); pm.collectionVariables.set('mainRestaurantId', r.restaurant.id); pm.test('totalTables=20', () => pm.expect(r.restaurant.totalTables).to.equal(20)); }"] } }]
        },
        {
          "name": "Admin updates capacity to 24",
          "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/restaurants/{{mainRestaurantId}}", "body": { "mode": "raw", "raw": "{\n  \"totalTables\": 24\n}" } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Updated 200', () => pm.response.to.have.status(200));", "pm.test('totalTables=24', () => pm.expect(pm.response.json().restaurant.totalTables).to.equal(24));"] } }]
        },
        {
          "name": "Public restaurant list",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/restaurants?page=1&limit=50" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('List 200', () => pm.response.to.have.status(200));", "pm.test('Has items array', () => pm.expect(pm.response.json().items).to.be.an('array'));"] } }]
        },
        {
          "name": "Admin creates throwaway restaurant",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/restaurants", "body": { "mode": "raw", "raw": "{\n  \"name\": \"EC Del {{$timestamp}}\",\n  \"address\": \"Bangkok\",\n  \"telephone\": \"021234567\",\n  \"opensAt\": \"10:00\",\n  \"closesAt\": \"22:00\",\n  \"totalTables\": 5\n}" } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Created 201', () => pm.response.to.have.status(201));", "if (pm.response.code === 201) pm.collectionVariables.set('delId', pm.response.json().restaurant.id);"] } }]
        },
        {
          "name": "Admin deletes restaurant",
          "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/restaurants/{{delId}}" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Deleted 204', () => pm.response.to.have.status(204));"] } }]
        },
        {
          "name": "Deleted restaurant is hidden (404)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/restaurants/{{delId}}" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Hidden 404', () => pm.response.to.have.status(404));"] } }]
        },
        {
          "name": "Normal user cannot create restaurant (403)",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{aToken}}" }], "url": "{{baseUrl}}/api/restaurants", "body": { "mode": "raw", "raw": "{\n  \"name\": \"Nope\",\n  \"address\": \"x\",\n  \"telephone\": \"021234567\",\n  \"opensAt\": \"10:00\",\n  \"closesAt\": \"22:00\",\n  \"totalTables\": 2\n}" } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Forbidden 403', () => pm.response.to.have.status(403));"] } }]
        }
      ]
    },
    {
      "name": "REQ 11 — Admin reservation query",
      "item": [
        {
          "name": "Seed booking A (2099-06-01)",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{aToken}}" }], "url": "{{baseUrl}}/api/reservations", "body": { "mode": "raw", "raw": "{\n  \"restaurantId\": \"{{mainRestaurantId}}\",\n  \"reservationDate\": \"2099-06-01\",\n  \"reservationTime\": \"18:00\",\n  \"partySize\": 2,\n  \"tablesRequested\": 1\n}" } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Booked 201', () => pm.response.to.have.status(201));"] } }]
        },
        {
          "name": "Seed booking B (2099-06-02)",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{bToken}}" }], "url": "{{baseUrl}}/api/reservations", "body": { "mode": "raw", "raw": "{\n  \"restaurantId\": \"{{mainRestaurantId}}\",\n  \"reservationDate\": \"2099-06-02\",\n  \"reservationTime\": \"19:00\",\n  \"partySize\": 2,\n  \"tablesRequested\": 1\n}" } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Booked 201', () => pm.response.to.have.status(201));"] } }]
        },
        {
          "name": "Pagination (page=1, limit=1)",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/admin/reservations?page=1&limit=1" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200', () => pm.response.to.have.status(200));", "const b = pm.response.json();", "pm.test('one item per page', () => pm.expect(b.items.length).to.equal(1));", "pm.test('total is a number', () => pm.expect(b.total).to.be.a('number'));"] } }]
        },
        {
          "name": "Filter by status=confirmed",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/admin/reservations?status=confirmed&limit=100" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200', () => pm.response.to.have.status(200));", "pm.test('all confirmed', () => pm.response.json().items.forEach(i => pm.expect(i.status).to.equal('confirmed')));"] } }]
        },
        {
          "name": "Filter by date=2099-06-01",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/admin/reservations?date=2099-06-01&limit=100" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200', () => pm.response.to.have.status(200));", "const items = pm.response.json().items;", "pm.test('has results', () => pm.expect(items.length).to.be.above(0));", "pm.test('all on that date', () => items.forEach(i => pm.expect(i.reservationDate).to.equal('2099-06-01')));"] } }]
        },
        {
          "name": "Filter by restaurantName=EC Main",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/admin/reservations?restaurantName=EC%20Main&limit=100" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200', () => pm.response.to.have.status(200));", "const items = pm.response.json().items;", "pm.test('has results', () => pm.expect(items.length).to.be.above(0));", "pm.test('all match name', () => items.forEach(i => pm.expect((i.restaurant && i.restaurant.name) || '').to.include('EC Main')));"] } }]
        },
        {
          "name": "Sort by date ascending",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/admin/reservations?sortBy=date&order=asc&limit=100" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200', () => pm.response.to.have.status(200));", "const items = pm.response.json().items;", "let ok = true; for (let i = 1; i < items.length; i++) { if (items[i-1].reservationDate > items[i].reservationDate) { ok = false; break; } }", "pm.test('sorted ascending by date', () => pm.expect(ok).to.be.true);"] } }]
        },
        {
          "name": "Normal user blocked from admin query (403)",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{aToken}}" }], "url": "{{baseUrl}}/api/admin/reservations" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Forbidden 403', () => pm.response.to.have.status(403));"] } }]
        }
      ]
    },
    {
      "name": "REQ 12 — Waitlist FIFO offers",
      "item": [
        {
          "name": "Admin creates 1-table restaurant",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/restaurants", "body": { "mode": "raw", "raw": "{\n  \"name\": \"EC Counter {{$timestamp}}\",\n  \"address\": \"Bangkok\",\n  \"telephone\": \"021234568\",\n  \"opensAt\": \"10:00\",\n  \"closesAt\": \"22:00\",\n  \"totalTables\": 1\n}" } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Created 201', () => pm.response.to.have.status(201));", "if (pm.response.code === 201) pm.collectionVariables.set('counterId', pm.response.json().restaurant.id);"] } }]
        },
        {
          "name": "User A fills the only table",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{aToken}}" }], "url": "{{baseUrl}}/api/reservations", "body": { "mode": "raw", "raw": "{\n  \"restaurantId\": \"{{counterId}}\",\n  \"reservationDate\": \"2099-07-01\",\n  \"reservationTime\": \"20:00\",\n  \"partySize\": 2,\n  \"tablesRequested\": 1\n}" } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Booked 201', () => pm.response.to.have.status(201));", "if (pm.response.code === 201) pm.collectionVariables.set('aBookingId', pm.response.json().id);"] } }]
        },
        {
          "name": "User B direct booking on full slot (409 SLOT_FULL)",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{bToken}}" }], "url": "{{baseUrl}}/api/reservations", "body": { "mode": "raw", "raw": "{\n  \"restaurantId\": \"{{counterId}}\",\n  \"reservationDate\": \"2099-07-01\",\n  \"reservationTime\": \"20:00\",\n  \"partySize\": 2,\n  \"tablesRequested\": 1\n}" } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('409', () => pm.response.to.have.status(409));", "pm.test('SLOT_FULL', () => pm.expect(pm.response.json().error.code).to.equal('SLOT_FULL'));"] } }]
        },
        {
          "name": "User B joins waitlist (first)",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{bToken}}" }], "url": "{{baseUrl}}/api/waitlist", "body": { "mode": "raw", "raw": "{\n  \"restaurantId\": \"{{counterId}}\",\n  \"reservationDate\": \"2099-07-01\",\n  \"reservationTime\": \"20:00\",\n  \"partySize\": 2,\n  \"tablesRequested\": 1\n}" } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Joined 201', () => pm.response.to.have.status(201));", "const e = pm.response.json();", "if (pm.response.code === 201) { pm.collectionVariables.set('bEntryId', e.id); pm.test('waiting', () => pm.expect(e.status).to.equal('waiting')); }"] } }]
        },
        {
          "name": "User C joins waitlist (second)",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{cToken}}" }], "url": "{{baseUrl}}/api/waitlist", "body": { "mode": "raw", "raw": "{\n  \"restaurantId\": \"{{counterId}}\",\n  \"reservationDate\": \"2099-07-01\",\n  \"reservationTime\": \"20:00\",\n  \"partySize\": 2,\n  \"tablesRequested\": 1\n}" } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Joined 201', () => pm.response.to.have.status(201));", "pm.test('waiting', () => pm.expect(pm.response.json().status).to.equal('waiting'));"] } }]
        },
        {
          "name": "User A cancels (frees capacity, promotes B)",
          "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{aToken}}" }], "url": "{{baseUrl}}/api/reservations/{{aBookingId}}" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Cancelled 204', () => pm.response.to.have.status(204));"] } }]
        },
        {
          "name": "Direct booking cannot bypass queue (409 WAITLIST_PRIORITY)",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/reservations", "body": { "mode": "raw", "raw": "{\n  \"restaurantId\": \"{{counterId}}\",\n  \"reservationDate\": \"2099-07-01\",\n  \"reservationTime\": \"20:00\",\n  \"partySize\": 2,\n  \"tablesRequested\": 1\n}" } },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('409', () => pm.response.to.have.status(409));", "pm.test('WAITLIST_PRIORITY', () => pm.expect(pm.response.json().error.code).to.equal('WAITLIST_PRIORITY'));"] } }]
        },
        {
          "name": "User B sees the offer (FIFO)",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{bToken}}" }], "url": "{{baseUrl}}/api/waitlist" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200', () => pm.response.to.have.status(200));", "const entry = pm.response.json().items.find(e => e.id === pm.collectionVariables.get('bEntryId'));", "pm.test('B is offered', () => pm.expect(entry.status).to.equal('offered'));", "pm.test('offer has expiry', () => pm.expect(entry.offerExpiresAt).to.not.equal(null));"] } }]
        },
        {
          "name": "User C still waiting (second in line)",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{cToken}}" }], "url": "{{baseUrl}}/api/waitlist" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200', () => pm.response.to.have.status(200));", "pm.test('C waiting', () => pm.expect(pm.response.json().items[0].status).to.equal('waiting'));"] } }]
        },
        {
          "name": "User B accepts offer (becomes reservation)",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{bToken}}" }], "url": "{{baseUrl}}/api/waitlist/{{bEntryId}}/accept" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Accepted 201', () => pm.response.to.have.status(201));", "pm.test('confirmed reservation', () => pm.expect(pm.response.json().status).to.equal('confirmed'));"] } }]
        }
      ]
    },
    {
      "name": "REQ 13 — Reservation history",
      "item": [
        {
          "name": "History: cancelled",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{aToken}}" }], "url": "{{baseUrl}}/api/reservations?status=cancelled" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200', () => pm.response.to.have.status(200));", "pm.test('all cancelled', () => pm.response.json().items.forEach(i => pm.expect(i.status).to.equal('cancelled')));"] } }]
        },
        {
          "name": "History: upcoming (confirmed)",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{aToken}}" }], "url": "{{baseUrl}}/api/reservations?when=upcoming&status=confirmed" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200', () => pm.response.to.have.status(200));", "pm.test('all confirmed', () => pm.response.json().items.forEach(i => pm.expect(i.status).to.equal('confirmed')));"] } }]
        },
        {
          "name": "History: completed",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{aToken}}" }], "url": "{{baseUrl}}/api/reservations?status=completed" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200', () => pm.response.to.have.status(200));", "pm.test('all completed', () => pm.response.json().items.forEach(i => pm.expect(i.status).to.equal('completed')));"] } }]
        },
        {
          "name": "History: past",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{aToken}}" }], "url": "{{baseUrl}}/api/reservations?when=past" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200', () => pm.response.to.have.status(200));"] } }]
        }
      ]
    }
  ]
}
